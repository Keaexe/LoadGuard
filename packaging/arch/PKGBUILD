# Builds the working tree this file is in: cd packaging/arch && makepkg -si
pkgname=loadguard-local
pkgver=0.1.0
pkgrel=1
pkgdesc='Limit the bandwidth of running apps'
arch=(x86_64 aarch64)
url='https://github.com/Keaexe/LoadGuard'
license=(GPL-3.0-only)
depends=(gcc-libs glibc nftables polkit systemd)
makedepends=(cargo)
provides=(loadguard)
conflicts=(loadguard)
options=(!debug)
_root=$(realpath "${startdir:-$PWD}/../..")

build() {
  cd "$_root"
  CARGO_TARGET_DIR="$srcdir/target" cargo build --release --locked --workspace
}

package() {
  cd "$_root"
  local t="$srcdir/target/release" id=io.github.keaexe.LoadGuard
  install -Dm755 "$t/loadguard" "$pkgdir/usr/bin/loadguard"
  install -Dm755 "$t/loadguard-helper" "$pkgdir/usr/lib/loadguard/loadguard-helper"
  install -Dm644 packaging/loadguard.service -t "$pkgdir/usr/lib/systemd/system"
  install -Dm644 packaging/${id}1.service -t "$pkgdir/usr/share/dbus-1/system-services"
  install -Dm644 packaging/${id}1.conf -t "$pkgdir/usr/share/dbus-1/system.d"
  install -Dm644 packaging/$id.policy -t "$pkgdir/usr/share/polkit-1/actions"
}
