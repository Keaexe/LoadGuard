# Builds the working tree this file is in: cd packaging/arch && makepkg -si
pkgname=loadguard-local
pkgver=0.1.0
pkgrel=1
pkgdesc='Limit the bandwidth of running apps'
arch=(x86_64 aarch64)
url='https://github.com/Keaexe/LoadGuard'
license=(GPL-3.0-only)
depends=(fontconfig freetype2 gcc-libs glibc hicolor-icon-theme libxkbcommon nftables polkit systemd)
makedepends=(cargo)
provides=(loadguard)
conflicts=(loadguard)
options=(!debug)
_root=$(realpath "${startdir:-$PWD}/../..")

build() {
  cd "$_root"
  CARGO_TARGET_DIR="$srcdir/target" cargo build --release --locked --workspace
}

package() {
  "$_root/packaging/install-files.sh" "$srcdir/target/release" "$pkgdir"
}
