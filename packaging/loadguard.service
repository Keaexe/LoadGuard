[Unit]
Description=LoadGuard bandwidth limiter
Documentation=https://github.com/Keaexe/LoadGuard
After=nftables.service

[Service]
Type=dbus
BusName=io.github.keaexe.LoadGuard1
ExecStart=/usr/lib/loadguard/loadguard-helper
ExecStopPost=/usr/lib/loadguard/loadguard-helper --cleanup
Restart=on-failure
StateDirectory=loadguard
StateDirectoryMode=0700
UMask=0077
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
